ALLOWED_ORIGIN=http://localhost:3000
PORT=3001

# Dev-only: bypass all rate limits. Honored only when NODE_ENV != "production".
# Useful for `pnpm seed` and other bulk dev tooling.
# RATE_LIMIT_DISABLED=1
# SEED_API_URL=#

# ─── Blob Storage Provider ────────────────────────────────────────────────────
# "azure" (default) or "r2" (Cloudflare R2 / S3-compatible)
BLOB_PROVIDER=azure

# Azure Blob Storage (when BLOB_PROVIDER=azure)
AZURE_STORAGE_CONTAINER_NAME=storage_continer_name
AZURE_STORAGE_ACCOUNT_NAME=storage_account_name
AZURE_STORAGE_ACCOUNT_KEY=storage_account_key
AZURE_STORAGE_CONNECTION_STRING=storage_connection_string

# Cloudflare R2 / S3-compatible (when BLOB_PROVIDER=r2)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET_NAME=vault
# R2_ENDPOINT=http://localhost:9000  # override for local dev (RustFS)

# Azure Cosmos DB
# Local dev: uses the emulator via docker-compose (well-known key auto-injected if endpoint is localhost)
# Production: leave COSMOS_DB_KEY unset → uses Azure managed identity (DefaultAzureCredential)
COSMOS_DB_ENDPOINT=https://localhost:8081
# COSMOS_DB_KEY=  # Omit in production for managed identity; auto-detected for localhost emulator
COSMOS_DB_DATABASE=vault
COSMOS_DB_CONTAINER=vault_entries

# Authentication
AUTH_SECRET=your_auth_secret_for_magic_links
JWT_SECRET=your_secret_key
# ACCESS_EXPIRES_SECONDS=900        # default 15 min
# REFRESH_EXPIRES_SECONDS=604800    # default 7 days

# Email (Development - Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=noreply@vault.app
APP_URL=http://localhost:3000

# Email (Production)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=your_resend_smtp_password
# EMAIL_FROM=noreply@vault.app
# APP_URL=https://your-app.example.com

