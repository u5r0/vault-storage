{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "types": ["vitest/globals", "@vitest/browser/context"],
    "noEmit": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.browser.test.ts",
    "src/__test__/**/*.ts"
  ]
}
