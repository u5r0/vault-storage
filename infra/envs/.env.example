# Terraform variable overrides for local runs.
# Copy to .env.local (gitignored) and fill in values.
# In CI these are set as GitHub Actions secrets/variables — see docs/deploy.md.

# ─── Deploy-time secrets (always needed by Terraform) ─────────────────────────
TF_VAR_ghcr_token=                    # GitHub PAT with read:packages scope
TF_VAR_cloudflare_api_token=          # Cloudflare API token (R2:Edit + Pages:Edit)

# ─── Infisical — Terraform machine identity (Universal Auth) ──────────────────
# These belong to the Terraform-only machine identity in Infisical.
# The Container App's runtime identity uses Azure Auth (no creds needed here).
TF_VAR_infisical_client_id=           # Infisical machine identity client ID
TF_VAR_infisical_client_secret=       # Infisical machine identity client secret
TF_VAR_infisical_project_id=          # Infisical project (workspace) ID
TF_VAR_infisical_identity_id=         # Infisical machine identity ID for the Container App runtime
# TF_VAR_infisical_env=prod           # defaults to "prod"; override for staging
