# Secrets — pass via environment variables or -var flags, never commit:
# Export to shell: 
# set -a
# source envs/.env.local
# set +a

TF_VAR_ghcr_token=
TF_VAR_jwt_secret=
TF_VAR_auth_secret=

TF_VAR_r2_access_key_id=
TF_VAR_r2_secret_access_key=
TF_VAR_cloudflare_api_token=

TF_VAR_smtp_user=
TF_VAR_smtp_pass=
TF_VAR_smtp_host=
TF_VAR_smtp_port=
TF_VAR_smtp_secure=
