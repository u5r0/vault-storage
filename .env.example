ALLOWED_ORIGIN=http://localhost:3000
PORT=3001

# Dev-only: bypass all rate limits. Honored only when NODE_ENV != "production".
# Useful for `pnpm seed` and other bulk dev tooling.
# RATE_LIMIT_DISABLED=1
# SEED_API_URL=#

# Server-side upload limit. The browser bundle uses VITE_MAX_UPLOAD_MB (baked
# at build time on Cloudflare Pages); this var controls server-side validation.
MAX_UPLOAD_MB=400

# (production only; leave empty in dev — Vite proxies /api)
# VITE_API_URL=https://your-api.example.com
# VITE_MAX_UPLOAD_MB=400

# ─── Blob Storage Provider ────────────────────────────────────────────────────
# "azure" (default for local dev) or "r2" (Cloudflare R2, used in production)
BLOB_PROVIDER=azure

# Azure Blob Storage (when BLOB_PROVIDER=azure)
AZURE_STORAGE_CONTAINER_NAME=storage_container_name
AZURE_STORAGE_ACCOUNT_NAME=storage_account_name
AZURE_STORAGE_ACCOUNT_KEY=storage_account_key
AZURE_STORAGE_CONNECTION_STRING=storage_connection_string

# Cloudflare R2 / S3-compatible (when BLOB_PROVIDER=r2)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET_NAME=vault
# R2_ENDPOINT=http://localhost:9000  # override for local dev (RustFS)

# ─── Azure Cosmos DB ──────────────────────────────────────────────────────────
# Local dev: emulator via docker-compose (well-known key auto-injected for localhost)
# Production: leave COSMOS_DB_KEY unset → managed identity via DefaultAzureCredential
COSMOS_DB_ENDPOINT=https://localhost:8081
# COSMOS_DB_KEY=   # omit in production; auto-detected for localhost emulator
COSMOS_DB_DATABASE=vault
COSMOS_DB_CONTAINER=vault_entries

# ─── Authentication ───────────────────────────────────────────────────────────
AUTH_SECRET=your_auth_secret_for_magic_links
JWT_SECRET=your_secret_key
# ACCESS_EXPIRES_SECONDS=900        # default 15 min
# REFRESH_EXPIRES_SECONDS=604800    # default 7 days

# ─── Email (Development — Mailpit) ────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=noreply@vault.app
APP_URL=http://localhost:3000

# ─── Email (Production — Resend example) ─────────────────────────────────────
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=your_resend_smtp_password
# EMAIL_FROM=noreply@vault.app
# APP_URL=https://your-app.example.com

# ─── Infisical (production / optional local) ──────────────────────────────────
# These are non-secret identifiers. Leave unset to use the .env path above.
# Set them to test the full Azure Auth / Infisical flow locally (requires az login).
# INFISICAL_IDENTITY_ID=  # Infisical machine identity ID (Azure Auth)
# INFISICAL_PROJECT_ID=   # Infisical project (workspace) ID
# INFISICAL_ENV=dev        # Infisical environment slug
# INFISICAL_SITE_URL=https://us.infisical.com  # override for EU region (https://eu.infisical.com) or self-hosted
