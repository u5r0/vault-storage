ALLOWED_ORIGIN=http://localhost:3000
PORT=3001

# Dev-only: bypass all rate limits. Honored only when NODE_ENV != "production".
# Useful for `pnpm seed` and other bulk dev tooling.
# RATE_LIMIT_DISABLED=1
# SEED_API_URL=#

VITE_MAX_UPLOAD_MB=400
# (production only; leave empty in dev — Vite proxies /api)
# VITE_API_URL=https://your-api.example.com

# Azure Blob Storage
AZURE_STORAGE_CONTAINER_NAME=storage_continer_name
AZURE_STORAGE_ACCOUNT_NAME=storage_account_name
AZURE_STORAGE_ACCOUNT_KEY=storage_account_key
AZURE_STORAGE_CONNECTION_STRING=storage_connection_string

# Azure Cosmos DB (local: Cosmium emulator via docker-compose, same well-known key)
COSMOS_DB_ENDPOINT=https://localhost:8081
COSMOS_DB_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_DB_DATABASE=vault
COSMOS_DB_CONTAINER=vault_entries

# Authentication
AUTH_SECRET=your_auth_secret_for_magic_links
JWT_SECRET=your_secret_key
# ACCESS_EXPIRES_SECONDS=900        # default 15 min
# REFRESH_EXPIRES_SECONDS=604800    # default 7 days

# Email (Development - Mailpit)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=noreply@vault.app
APP_URL=http://localhost:3000

# Email (Production)
# SMTP_URL=smtp://smtp.sendgrid.net:587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# EMAIL_FROM=noreply@vault.app
# APP_URL=https://your-app.example.com

