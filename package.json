{
  "name": "vault-storage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
  "dev": "pnpm -F @vault/sdk build && docker compose up -d --wait && concurrently -n api,web -c \"#a78bfa,#22d3ee\" \"pnpm -F @vault/server dev\" \"pnpm -F @vault/web dev\"",
  "dev:web": "pnpm -F @vault/sdk build && pnpm -F @vault/web dev",
  "dev:api": "pnpm -F @vault/sdk build && pnpm -F @vault/server dev",
  "seed": "pnpm -F @vault/server seed",
  "build": "pnpm -F @vault/sdk build && pnpm -F @vault/web build && pnpm -F @vault/server build",
  "start": "pnpm -F @vault/server start",
    "preview": "pnpm -F @vault/web preview",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:browser",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration:r2": "BLOB_PROVIDER=r2 vitest run --project integration",
    "test:browser": "vitest run --project web-browser",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.0.0",
    "msw": "^2.14.6",
    "tsx": "^4.21.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10 <11"
  }
}
