{
  "name": "vault-storage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n azurite,api,web -c \"#fbbf24,#a78bfa,#22d3ee\" \"docker compose up\" \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @vault/web dev",
    "dev:api": "tsx watch apps/server/src/index.ts",
    "seed": "tsx apps/server/scripts/seed.ts",
    "build": "pnpm --filter @vault/web build",
    "start": "tsx apps/server/src/index.ts",
    "preview": "pnpm --filter @vault/web preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.6.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  }
}
