{
  "name": "vault-storage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n azurite,api,web -c \"#fbbf24,#a78bfa,#22d3ee\" \"pnpm azurite\" \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite --host",
    "dev:api": "tsx watch server/index.ts",
    "azurite": "azurite-blob --silent --location ./.azurite-data --debug ./.azurite-data/debug.log --blobHost 127.0.0.1 --blobPort 10000",
    "seed": "tsx scripts/seed.ts",
    "build": "vue-tsc -b && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.31.0",
    "@hono/node-server": "^2.0.1",
    "@hono/zod-validator": "^0.7.6",
    "@vault/sdk": "workspace:*",
    "dotenv": "^17.2.3",
    "hono": "^4.12.17",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "azurite": "^3.35.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.1",
    "vitest": "^4.1.6",
    "vue-tsc": "^2.1.10"
  }
}
